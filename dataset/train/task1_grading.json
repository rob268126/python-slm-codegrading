{
  "task": "task1_rubric_grading",
  "description": "Input = đề bài (tra theo exam_id trong exams.json) + code sinh viên (đọc từ code_file) (+ compile_log, test_report tuỳ chọn). Output = 6 điểm thành phần và tổng điểm 0-10.",
  "input_fields": [
    "exam_id",
    "exam_type",
    "language",
    "code_file (đường dẫn tương đối tới file .cpp)",
    "compile_log (optional)",
    "test_report (optional)"
  ],
  "output_fields": [
    "rubric.compilable(0-1)",
    "rubric.io_format(0-1)",
    "rubric.logic(0-4)",
    "rubric.edge_case(0-2)",
    "rubric.complexity(0-1)",
    "rubric.code_quality(0-1)",
    "total_score(0-10)"
  ],
  "metric": "QWK trên total_score; MAE; exact-match từng chiều",
  "n_samples": 32,
